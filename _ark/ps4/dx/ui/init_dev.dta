{if {&& {! {file_exists "settings/gameplay/nolanes.dta"}} {dx_file_exists "ps4/track/guitar/guitar_roll_lane_unlit.entity_ps4"}}
	{dx_file_delete "ps4/track/guitar/guitar_roll_lane_unlit.entity_ps4"}
}
{if {dx_file_exists "ps4/config/include/beatmatcher.dta_dta_ps4"}
   {dx_file_delete "ps4/config/include/beatmatcher.dta_dta_ps4"}
}
{if {dx_file_exists "ps4/ui/results/scripts/results_no_part.script_dta_ps4"}
   {dx_file_delete "ps4/ui/results/scripts/results_no_part.script_dta_ps4"}
}
{if {file_exists "insong.dta"}
   {dx_file_delete "insong.dta"}
}
{if {file_exists "RB4DX.ini"}
   {dx_file_delete "RB4DX.ini"}
}
{if {file_exists "speedmod.ini"}
	{dx_file_delete "speedmod.ini"}
}
{if {file_exists "autoplay.ini"}
   {dx_file_delete "autoplay.ini"}
}
{if {file_exists "drunkmode.ini"}
   {dx_file_delete "drunkmode.ini"}
}
{if_else {file_exists "settings/visuals/noui.dta"}
	{unless {dx_file_exists "ps4/ui/game/hud0.scene_ps4"}
		{dx_file_rename "ps4/ui/game/hud.scene_ps4" "ps4/ui/game/hud0.scene_ps4"}
		{dx_write_null_file "ps4/ui/game/hud.scene_ps4"}
	}
	{unless {dx_file_exists "ps4/ui/game/hud.scene_ps4"}
		{if {dx_file_exists "ps4/ui/game/hud0.scene_ps4"}
			{dx_file_delete "ps4/ui/game/hud.scene_ps4"}
			{dx_file_rename "ps4/ui/game/hud0.scene_ps4" "ps4/ui/game/hud.scene_ps4"}
		}
	}
}
{dx_write_null_file "saving.ini"}

{if {dx_file_exists "ps4/ui_bak"}
	{unless {dx_file_exists "ps4/ui_prerivals"}
		{dx_file_rename "ps4/ui" "ps4/ui_prerivals"}
	}
	{dx_file_rename "ps4/ui_bak" "ps4/ui"}
}
{if {dx_file_exists "ps4/ui_prerivals"}
	{file_rmdir "/data/GoldHEN/RB4DX/ps4/ui_prerivals"}
}

{if {dx_file_exists "ps4/dx/custom_sounds/shell_music/rock band 4 (1.08).bank"}
	{dx_file_delete "ps4/dx/custom_sounds/shell_music/rock band 4 (1.08).bank"}
}

{if {is_emu}
	{unless {file_exists "settings/visuals/emucrashdetect.dta"}
		{if_else {file_exists "emucrashdetect.dta"}
			{do
				{dx_file_delete "settings/emu_override.dta"}
				{dx_file_delete "emucrashdetect.dta"}
			}
			{dx_write_null_file "emucrashdetect.dta"}
		}
	}
}

{write_file "data:/GoldHEN/RB4DX/discordrp.json" {array ({sprint "{\qGame mode\q:\qdefaults\q}"})}}
